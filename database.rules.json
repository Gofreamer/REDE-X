{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('isAdmin').val() === true)",
        "isAdmin": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('isAdmin').val() === true || newData.val() === false || newData.val() == null)"
        }
      }
    },
    "handles": {
      ".read": true,
      "$handle": {
        ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid || root.child('users').child(auth.uid).child('isAdmin').val() === true)"
      }
    },
    "npcProfiles": {
      ".read": "auth != null",
      "$handle": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true"
      }
    },
    "following": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "mediaLibrary": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true"
    },
    "highlights": {
      ".read": "auth != null",
      "$handle": {
        ".write": "auth != null"
      }
    },
    "siteSettings": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true"
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null"
      }
    },
    "dms": {
      ".read": "auth != null",
      "$tid": {
        ".write": "auth != null",
        "messages": {
          "$mid": {
            ".write": "auth != null"
          }
        }
      }
    },
    "posts": {
      ".read": "auth != null",
      ".indexOn": ["createdAt"],
      "$pid": {
        ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid || root.child('users').child(auth.uid).child('isAdmin').val() === true || newData.hasChild('likes') || newData.hasChild('likeCount') || newData.hasChild('comments') || newData.hasChild('commentCount') || newData.hasChild('pinned') || newData.hasChild('publishAt') || newData.hasChild('scheduled') || newData.hasChild('createdAt') || newData.hasChild('timeOverride'))",
        "likes": {
          "$uid": { ".write": "auth != null && auth.uid === $uid" }
        },
        "likeCount": { ".write": "auth != null" },
        "comments": { ".write": "auth != null" },
        "commentCount": { ".write": "auth != null" },
        "pinned": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true"
        }
      }
    },
    "stories": {
      ".read": "auth != null",
      ".indexOn": ["createdAt"],
      "$sid": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true"
      }
    }
  }
}
